{
  "name": "bingo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:server",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:server": "npm --workspace apps/server run dev",
    "build": "npm-run-all build:shared build:web build:server",
    "build:web": "npm --workspace apps/web run build",
    "build:server": "npm --workspace apps/server run build",
    "build:shared": "npm --workspace packages/shared run build",
    "typecheck": "npm-run-all typecheck:shared typecheck:web typecheck:server",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "typecheck:server": "npm --workspace apps/server run typecheck",
    "typecheck:shared": "npm --workspace packages/shared run typecheck",
    "lint": "npm --workspace apps/web run lint",
    "test": "npm --workspace apps/server run test",
    "prisma:generate": "npm --workspace apps/server run prisma:generate",
    "prisma:migrate": "npm --workspace apps/server run prisma:migrate",
    "cleanup:uploads": "npm --workspace apps/server run cleanup:uploads",
    "cleanup:rooms": "npm --workspace apps/server run cleanup:rooms"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  }
}
